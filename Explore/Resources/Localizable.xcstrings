        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阅读"
          }
        }
      }
    },
    "Reading needs no account and this app has no analytics. Thumbnails and icons come from Explore's own server, never from third parties. With an account, Explore keeps your email, your name, a hash of your password and the blogs you follow, and never what you read." : {
      "localizations" : {
        "zh-Hans" : {
