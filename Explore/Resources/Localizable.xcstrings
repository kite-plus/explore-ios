    },
    "An account with this email already exists. Sign in instead." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个邮箱已经注册过账号，请直接登录。"
          }
        }
      }
    },
    "Authors can leave at any time: answer Explore's crawler with 410 Gone, disallow KiteExplore in robots.txt, or open an issue." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作者随时可以退出：让网站对 Explore 的抓取器返回 410 Gone，在 robots.txt 中禁止 KiteExplore，或者提交一个 issue。"
          }
        }
      }
    },
    "Authors submit their blog and its feed is checked on the spot. A maintainer reviews blogs that pass: personal and independent blogs, updated within the last 12 months." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作者提交博客后，订阅源会当场检查。通过检查的博客由维护者审核：收录近 12 个月内有更新的个人独立博客。"
          }
        }
      }
    },
