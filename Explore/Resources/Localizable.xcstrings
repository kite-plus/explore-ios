{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is now linked to your account. You can remove the DNS record." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已关联到你的账号，现在可以删除这条 DNS 记录了。"
          }
        }
      }
    },
    "%@ · %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "A maintainer will review %@. Check its status any time under My Submissions." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "维护者会审核 %@。随时可以在“我的提交”里查看进度。"
          }
        }
      }
    },
    "A post opens at its original address, with no page in between. Explore adds only utm_source, so the author can tell the visit came from Explore; nothing in it identifies you." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文章直接打开原始地址，中间没有跳转页。Explore 只加上 utm_source，让作者知道访问来自 Explore；其中没有任何能识别你的信息。"
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
