    },
    "Explore could not handle the request." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore 无法处理这个请求。"
          }
        }
      }
    },
    "Explore gathers the public feeds of independent blogs and shows their latest posts, newest first. Any blog with RSS, Atom or JSON Feed can join." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore 汇集独立博客公开的订阅源，按发布时间展示最新文章。任何提供 RSS、Atom 或 JSON Feed 的博客都可以加入。"
          }
        }
      }
    },
    "Explore hasn't checked this link yet." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore 还没有检测过这个链接。"
          }
        }
      }
    },
    "Explore is having trouble right now. Try again later." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore 服务暂时出了问题，请稍后再试。"
          }
        }
      }
    },
    "Explore is the discovery side of Kite Plus." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore 是 Kite Plus 负责“发现”的部分。"
          }
        }
      }
    },
    "Explore keeps neither post content nor images. What you see is a cache of what each feed says right now; when an author edits or deletes a post, Explore follows." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore 不保存文章正文和图片。你看到的只是各个订阅源当前内容的缓存；作者修改或删除文章后，Explore 会随之更新。"
          }
